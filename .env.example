# ============================================================================
# Variables de Entorno de RutasJamar (Plantilla Segura para GitHub / Vercel)
# ============================================================================
# Copia este archivo como `.env.local` para desarrollo local, o configura
# estas variables en el panel de Vercel (Settings -> Environment Variables).
# NUNCA escribas claves reales dentro de este archivo (.env.example).

# VITE_GOOGLE_MAPS_API_KEY: Clave de Google Maps JavaScript / Geocoding API
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_FIREBASE_DATABASE_URL: URL de Firebase Realtime Database para sincronización en la nube
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_AUTH_SECRET=""

# VITE_RECOVERY_WHATSAPP: Número oficial para solicitudes de recuperación de acceso
VITE_RECOVERY_WHATSAPP=""
